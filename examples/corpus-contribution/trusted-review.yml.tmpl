# TEMPLATE ONLY. Not enabled.
# Copy into the knowledge-content repository as
# .github/workflows/trusted-knowledge-review.yml and drop the .tmpl suffix
# (the suffix keeps this file out of this package's YAML corpus gates).
# This file never installs itself.
#
# Before enabling, replace every <pin> with a reviewed action revision and
# a reviewed vaws-knowledge package version. The placeholders keep
# login-shaped action refs out of the redaction gate and force a deliberate
# pin. Root CLI, package dependencies, OpenViking URL, and live workflow
# enablement stay with the integrator.
#
# Secret-bearing jobs check out the default branch, never the pull-request
# head. PR Markdown is fetched as data through the trusted package. Fork
# code is not installed or executed. Recall uses the configured OpenViking
# adapter; missing recall does not permit publish.

name: Trusted knowledge review

on:
  pull_request:
    paths:
      - '**/*.md'

permissions:
  contents: read

jobs:
  review:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    permissions:
      contents: write
      pull-requests: write
    env:
      XAI_API_KEY: ${{ secrets.XAI_API_KEY }}
      XAI_MODEL: ${{ vars.XAI_MODEL }}
      GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
      OPENVIKING_URL: ${{ vars.OPENVIKING_URL }}
    steps:
      - name: Checkout trusted default branch only
        uses: actions/checkout@<pin>
        with:
          persist-credentials: false
          ref: ${{ github.event.repository.default_branch }}

      - uses: actions/setup-python@<pin>
        with:
          python-version: '3.11'

      - name: Install the trusted knowledge package (pinned, never the PR)
        run: |
          python -m pip install --upgrade pip
          pip install "vaws-knowledge==<pin>"

      - name: Review PR markdown as data
        env:
          GITHUB_REPOSITORY: ${{ github.repository }}
          GITHUB_EVENT_PATH: ${{ github.event_path }}
        run: |
          set -euo pipefail
          python -m vaws_knowledge.contribution ci \
            --event "$GITHUB_EVENT_PATH" \
            --checkout-ref "${{ github.event.repository.default_branch }}" \
            --json review.json
          test -s review.json
