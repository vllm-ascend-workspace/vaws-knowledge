# Opt-in template for the knowledge corpus repository: build a dense OVPack
# from the exact pushed commit and assemble a verified local release
# directory. Copy into .github/workflows/ of the corpus repo yourself and
# drop the .tmpl suffix; this file never installs itself anywhere.
#
# Before enabling, replace every <pin> action placeholder with the reviewed
# action revision. Everything else runs as plain shell.
#
# Real GitHub Release creation / network publishing stays DISABLED this
# round: the job ends by uploading the release directory as a workflow
# artifact. The commented final step shows the intended handoff and must not
# be enabled before the main agent wires the release policy.
#
# The pipeline: pinned deps -> loopback embedding endpoint (FastEmbed/ONNX
# MiniLM, generation rejected) -> scratch OpenViking server -> native
# export_ovpack(include_vectors=True) -> release manifest with the source Git
# SHA, builder/OpenViking versions and model/tokenizer checksums -> offline
# verify. Clients later import with vector_mode=require. The pinned model
# name and versions come from the installed package (`pins`), so this
# template never hard-codes them.

name: Build knowledge OVPack release
on:
  workflow_dispatch:
  # push:
  #   branches: [main]

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@<pin>

      - uses: actions/setup-python@<pin>
        with:
          python-version: "3.12"

      - name: Install pinned build dependencies
        run: |
          python -m pip install --upgrade pip
          python -m pip install "openviking==0.4.19" "openviking-sdk==0.1.10" "fastembed==0.8.0"
          # vaws-knowledge provides `python -m vaws_knowledge.distribution` and
          # the loopback embedding server module (`vaws_knowledge.local.embedding`,
          # owned by the local-knowledge task). Install the pinned wheel here:
          #   python -m pip install "vaws-knowledge==<pinned>"

      - name: Read the pinned contract from the package
        run: |
          OV_MODEL="$(python -m vaws_knowledge.distribution pins | python -c 'import json,sys; print(json.load(sys.stdin)["embedding_model"])')"
          echo "OV_MODEL=$OV_MODEL" >> "$GITHUB_ENV"

      - name: Start the loopback embedding endpoint
        run: |
          export TOKENIZERS_PARALLELISM=false
          nohup python -m vaws_knowledge.local.embedding \
            --port 18771 --cache-dir "$RUNNER_TEMP/model-cache" \
            --metrics "$RUNNER_TEMP/embedding.jsonl" >embedding.log 2>&1 &
          for i in $(seq 1 240); do
            curl -sf http://127.0.0.1:18771/health && exit 0
            sleep 1
          done
          echo "embedding endpoint did not become ready" >&2
          exit 1

      - name: Start the scratch OpenViking build server
        run: |
          ROOT_KEY="$(openssl rand -hex 24)"
          echo "OV_ROOT_KEY=$ROOT_KEY" >> "$GITHUB_ENV"
          OV_LOOPBACK=local-loopback
          cat > "$RUNNER_TEMP/openviking.json" <<EOF
          {
            "storage": {"workspace": "$RUNNER_TEMP/ov-build-state",
              "vectordb": {"name": "context", "backend": "local"},
              "agfs": {"backend": "local"}},
            "embedding": {"dense": {
              "api_base": "http://127.0.0.1:18771/v1", "api_key": "$OV_LOOPBACK",
              "provider": "openai", "dimension": 384,
              "model": "$OV_MODEL"}},
            "vlm": {"api_base": "http://127.0.0.1:18771/v1",
              "api_key": "$OV_LOOPBACK", "provider": "openai",
              "model": "generation-disabled"},
            "server": {"host": "127.0.0.1", "port": 18772,
              "auth_mode": "api_key", "root_api_key": "$ROOT_KEY"}
          }
          EOF
          chmod 600 "$RUNNER_TEMP/openviking.json"
          nohup openviking-server --config "$RUNNER_TEMP/openviking.json" >openviking.log 2>&1 &
          for i in $(seq 1 120); do
            curl -sf http://127.0.0.1:18772/health && exit 0
            sleep 1
          done
          echo "openviking-server did not become ready" >&2
          exit 1

      - name: Provision the tenant data key (root key administers only)
        run: |
          DATA_KEY="$(python -m vaws_knowledge.distribution tenant-key \
            --openviking-url http://127.0.0.1:18772 --user-id ci-builder)"
          echo "OV_DATA_KEY=$DATA_KEY" >> "$GITHUB_ENV"

      - name: Build the dense OVPack from the exact commit
        run: |
          python -m vaws_knowledge.distribution build \
            --repo "$GITHUB_WORKSPACE" --sha "$GITHUB_SHA" --corpus-subdir corpus \
            --out dist --openviking-url http://127.0.0.1:18772 \
            --api-key "$OV_DATA_KEY" \
            --embedding-health-url http://127.0.0.1:18771/health \
            --model-cache "$RUNNER_TEMP/model-cache"

      - name: Assemble and verify the release directory
        run: |
          python -m vaws_knowledge.distribution make-release \
            --pack dist/corpus-*.ovpack --manifest dist/corpus-*.release.json \
            --out release
          python -m vaws_knowledge.distribution verify --release release

      - uses: actions/upload-artifact@<pin>
        with:
          name: knowledge-ovpack-${{ github.sha }}
          path: release/
          retention-days: 14

      # DISABLED this round — real release creation / network publishing.
      # - name: Publish the GitHub Release
      #   run: |
      #     gh release create "knowledge-${GITHUB_SHA::12}" release/* \
      #       --title "Knowledge ${GITHUB_SHA::12}" --notes "OVPack for $GITHUB_SHA"
