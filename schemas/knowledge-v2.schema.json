{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vllm-ascend-workspace/vaws-knowledge/schemas/knowledge-v2.schema.json",
  "title": "VAWS Federated Knowledge Document v2",
  "$comment": "Every object in this schema sets additionalProperties:false on purpose. The schema IS the egress whitelist: a field that is not declared here cannot leave a contributing fork. Widening any object is a privacy decision, not a formatting decision.",

  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "layer", "updated_at", "entries"],
  "properties": {
    "schema_version": { "const": 2 },
    "kind": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "description": "Document family, e.g. known-failure-signatures, version-compatibility."
    },
    "layer": {
      "enum": ["verified", "unverified"],
      "description": "Must agree with the corpus directory holding this file. corpus/verified/ may only contain layer=verified."
    },
    "updated_at": { "$ref": "#/$defs/date" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },

  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },

    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },

    "constraint": {
      "$comment": "One applicability dimension. There is no 'omitted' state: an entry must either bound the dimension or explicitly claim independence from it. An 'any' claim must state its basis, because unexamined independence claims are the usual root cause of contradictory knowledge between forks.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any", "basis"],
          "properties": {
            "any": { "const": true },
            "basis": {
              "type": "string",
              "minLength": 12,
              "description": "Why this fact is believed independent of this dimension. Reviewed as a claim, not as prose."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["values"],
          "properties": {
            "values": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 },
              "description": "Exact set of values this fact was established on."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["range"],
          "properties": {
            "range": {
              "type": "object",
              "additionalProperties": false,
              "required": ["min", "max"],
              "properties": {
                "min": { "type": ["string", "null"] },
                "max": { "type": ["string", "null"] }
              },
              "description": "Inclusive bounds. null means unbounded on that side, which is a claim about untested territory and should be justified in the rule body."
            }
          }
        }
      ]
    },

    "scope": {
      "$comment": "The applicability coordinate. All dimensions are required so that 'undeclared' is not representable. Conflict resolution between forks works by diffing these coordinates.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "soc",
        "cann",
        "driver",
        "python_abi",
        "torch",
        "torch_npu",
        "vllm",
        "vllm_ascend",
        "model",
        "topology",
        "execution_mode",
        "component"
      ],
      "properties": {
        "soc": { "$ref": "#/$defs/constraint" },
        "cann": { "$ref": "#/$defs/constraint" },
        "driver": { "$ref": "#/$defs/constraint" },
        "python_abi": { "$ref": "#/$defs/constraint" },
        "torch": { "$ref": "#/$defs/constraint" },
        "torch_npu": { "$ref": "#/$defs/constraint" },
        "vllm": { "$ref": "#/$defs/constraint" },
        "vllm_ascend": { "$ref": "#/$defs/constraint" },
        "model": { "$ref": "#/$defs/constraint" },
        "topology": {
          "$ref": "#/$defs/constraint",
          "description": "Parallel topology descriptors, e.g. tp8, dp4, ep16, multinode, single-node."
        },
        "execution_mode": {
          "$ref": "#/$defs/constraint",
          "description": "e.g. eager, aclgraph, piecewise, prefill-decode-disaggregated."
        },
        "component": {
          "$ref": "#/$defs/constraint",
          "description": "Owning subsystem, e.g. service-bootstrap, ssh-transport, attention-kernel, hccl."
        }
      }
    },

    "concrete_environment": {
      "$comment": "The single environment the fact was actually observed on. Unlike scope, these are exact strings, not constraints. This is what makes a verified claim auditable.",
      "type": "object",
      "additionalProperties": false,
      "required": ["soc", "cann", "driver", "torch", "torch_npu", "vllm", "vllm_ascend"],
      "properties": {
        "soc": { "type": "string", "minLength": 1 },
        "cann": { "type": "string", "minLength": 1 },
        "driver": { "type": "string", "minLength": 1 },
        "python_abi": { "type": "string" },
        "torch": { "type": "string", "minLength": 1 },
        "torch_npu": { "type": "string", "minLength": 1 },
        "vllm": { "type": "string", "minLength": 1 },
        "vllm_ascend": { "type": "string", "minLength": 1 },
        "model": { "type": "string" },
        "topology": { "type": "string" },
        "execution_mode": { "type": "string" }
      }
    },

    "evidence": {
      "$comment": "Evidence must be a reference, never prose. Prose that reads like evidence but cannot be followed is worse than no evidence.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ref"],
      "properties": {
        "type": { "enum": ["run_manifest", "pull_request", "issue", "commit", "ci_run"] },
        "ref": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    },

    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contributor", "origin_repo", "submitted_at", "redaction_profile"],
      "properties": {
        "contributor": {
          "type": "string",
          "minLength": 1,
          "description": "GitHub handle of the submitter, or 'anonymous'."
        },
        "origin_repo": {
          "type": "string",
          "minLength": 1,
          "description": "Fork this entry was exported from, e.g. owner/vllm-ascend-workspace."
        },
        "submitted_at": { "$ref": "#/$defs/date" },
        "redaction_profile": {
          "type": "string",
          "pattern": "^r[0-9]+$",
          "description": "Version of the source-side redaction ruleset applied at export. Lets the main repo re-scan the corpus when the ruleset tightens."
        }
      }
    },

    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "verified_by", "verified_against", "last_verified_at"],
      "properties": {
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "verified_by": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Handles that confirmed the claim. A review bot is never a valid value here, and the submitter alone is not sufficient for layer=verified."
        },
        "verified_against": { "$ref": "#/$defs/concrete_environment" },
        "last_verified_at": {
          "$ref": "#/$defs/date",
          "description": "Deliberately separate from lifecycle.updated_at: rewording an entry is not re-verifying it."
        }
      }
    },

    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_seen", "updated_at"],
      "properties": {
        "first_seen": { "$ref": "#/$defs/date" },
        "updated_at": { "$ref": "#/$defs/date" },
        "supersedes": {
          "type": "array",
          "items": { "$ref": "#/$defs/uuid" }
        },
        "superseded_by": {
          "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
        },
        "resolved_by": {
          "$comment": "A fixed failure signature is marked resolved, not deleted. Deleting it strands everyone still on the affected versions.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "ref"],
              "properties": {
                "type": { "enum": ["pull_request", "commit", "release"] },
                "ref": { "type": "string", "minLength": 1 }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },

    "conflict": {
      "$comment": "Two forks asserting opposite things about the same coordinate is normally not a disagreement about facts; it is an incomplete coordinate. Conflicts are recorded as undeclared dimensions so that the fix is coordinate refinement, not arbitration. Same confounder logic as the experiment ledger.",
      "type": "object",
      "additionalProperties": false,
      "required": ["with", "undeclared_dimensions", "recorded_at"],
      "properties": {
        "with": { "$ref": "#/$defs/uuid" },
        "undeclared_dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "soc", "cann", "driver", "python_abi", "torch", "torch_npu",
              "vllm", "vllm_ascend", "model", "topology", "execution_mode", "component"
            ]
          }
        },
        "recorded_at": { "$ref": "#/$defs/date" },
        "note": { "type": "string" }
      }
    },

    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "symptom", "root_cause", "resolution"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "symptom": { "type": "string", "minLength": 1 },
        "root_cause": { "type": "string", "minLength": 1 },
        "resolution": { "type": "string", "minLength": 1 },
        "avoidance": { "type": "string" },
        "fingerprints": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Lowercase observable signatures used for retrieval matching."
        }
      }
    },

    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uuid",
        "slug",
        "content_hash",
        "status",
        "confidence",
        "scope",
        "provenance",
        "lifecycle",
        "rule"
      ],
      "properties": {
        "uuid": {
          "$ref": "#/$defs/uuid",
          "description": "Stable identity across revisions and across forks. Never derived from content."
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "description": "Human-readable handle. Mutable, and never used as identity."
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Version identity over the canonicalized scope+rule payload. Makes federated sync idempotent per entry."
        },
        "status": {
          "enum": ["verified", "unverified", "stale", "deprecated", "resolved"]
        },
        "confidence": { "enum": ["high", "medium", "low"] },
        "scope": { "$ref": "#/$defs/scope" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "verification": { "$ref": "#/$defs/verification" },
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "conflicts": {
          "type": "array",
          "items": { "$ref": "#/$defs/conflict" }
        },
        "rule": { "$ref": "#/$defs/rule" }
      },
      "allOf": [
        {
          "$comment": "verified and stale both assert the claim was once actually established, so both need a full verification record. stale only means it has not been re-verified recently enough.",
          "if": {
            "properties": { "status": { "enum": ["verified", "stale"] } },
            "required": ["status"]
          },
          "then": {
            "required": ["verification"],
            "properties": {
              "verification": {
                "properties": {
                  "evidence": { "minItems": 1 },
                  "verified_by": { "minItems": 1 }
                }
              }
            }
          }
        },
        {
          "$comment": "A resolved signature must point at what fixed it, otherwise consumers cannot tell whether they are past it.",
          "if": {
            "properties": { "status": { "const": "resolved" } },
            "required": ["status"]
          },
          "then": {
            "required": ["lifecycle"],
            "properties": {
              "lifecycle": {
                "properties": { "resolved_by": { "type": "object" } },
                "required": ["resolved_by"]
              }
            }
          }
        },
        {
          "$comment": "high confidence is reserved for claims that survived review, not for confident writing.",
          "if": {
            "properties": { "confidence": { "const": "high" } },
            "required": ["confidence"]
          },
          "then": {
            "properties": { "status": { "enum": ["verified", "stale", "resolved"] } }
          }
        }
      ]
    }
  }
}
